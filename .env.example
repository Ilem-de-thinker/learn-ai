# ADMIN_PASSWORD: Password required to log into the Admin Dashboard.
ADMIN_PASSWORD="@Ilemilem"

# DATABASE_URL: Database connection string (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# VITE_DATABASE_URL: Same as DATABASE_URL but exposed to frontend (Vite convention)
VITE_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# VITE_ADMIN_PASSWORD: Admin password for dashboard login (exposed to frontend)
VITE_ADMIN_PASSWORD="@Ilemilem"
